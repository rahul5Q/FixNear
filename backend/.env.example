# ==============================================================================
# FixNear Backend - Example Environment Configuration
# Copy this file to backend/.env for local overrides.
# Do not commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# MongoDB Connection URI (defaults to mongodb://localhost:27017/ if unset)
MONGO_URI=mongodb://localhost:27017/

# JWT Authentication Secret & Expiration (JWT_SECRET must not be default in production)
JWT_SECRET=your-secure-random-jwt-secret-key-change-in-production
JWT_EXPIRE_MINUTES=1440

# Provider Onboarding Authorization Secret (shared secret code, not automated background check)
PROVIDER_INVITE_SECRET=your-secure-provider-invite-secret-in-production

# CORS Allowed Origins (comma-separated; required in production; never use '*' with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (per remote IP address)
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
# Default in-memory storage (memory://). In multi-worker production, configure Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
