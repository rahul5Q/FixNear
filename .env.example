# ==============================================================================
# FixNear Local Service Marketplace - Example Environment Configuration
# Copy this file to .env (or configure backend/.env and frontend/.env) for local overrides.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# Backend Configuration
APP_ENV=development
MONGO_URI=mongodb://localhost:27017/
JWT_SECRET=your-secure-random-jwt-secret-key-change-in-production
JWT_EXPIRE_MINUTES=1440

# Provider Registration Authorization Secret (shared secret code, not automated background check)
PROVIDER_INVITE_SECRET=your-secure-provider-invite-secret-in-production

# CORS Configuration (comma-separated origins; exact production domain required in production; never use '*' with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (per remote IP address)
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
# For single process: memory://. For multi-worker production: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Frontend API Base URL
VITE_API_URL=http://127.0.0.1:8000
