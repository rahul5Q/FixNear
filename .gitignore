# ==============================================================================
# FixNear Local Service Marketplace - Root .gitignore
# ==============================================================================

# Python / Virtual Environment
backend/venv/
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Environment variables & secrets (keep .env.example trackable)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# IDE & Editor temporary files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating System temporary files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
